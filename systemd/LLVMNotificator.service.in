[Unit]
Description=LLVMNotificator - GitHub release watcher daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart="@BINARY@"
Restart=on-failure
RestartSec=5s

Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=MIMALLOC_PURGE_DELAY=0
Environment=MIMALLOC_PAGE_RESET=1
Environment=MIMALLOC_EAGER_COMMIT=0
Environment=MIMALLOC_ARENA_EAGER_COMMIT=0
Environment=MIMALLOC_SEGMENT_CACHE=0
Environment=MIMALLOC_RESERVE_HUGE_OS_PAGES=0
Environment=MIMALLOC_ALLOW_LARGE_OS_PAGES=0

MemoryHigh=32M
MemoryMax=64M
MemorySwapMax=0
TasksMax=32
IOSchedulingClass=best-effort
IOSchedulingPriority=4

NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
